{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["XxInvictus", "Tfarcenim", "CommodoreThrawn"],
  "contact": {
    "sources": "${issue_tracker_url}"
  },

  "license": "${mod_license}",
  "icon": "assets/modid/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "${mod_group_id}.${mod_id}.${mod_name}Fabric"
    ],
    "client": [
      "${mod_group_id}.${mod_id}.client.${mod_name}ClientFabric"
    ]
  },
  "mixins": [
    "${mod_id}.fabric.mixins.json",
    "${mod_id}.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "java": ">=17"
  }
}
